cat > ~/OpenClaw_Light/COCKPIT/ENGINE/HERMES_PILOT.ocm << 'EOF'
# HERMES_PILOT.ocm
# OpenClaw_Light — Hermes Pilot Engine
# Pilotage vocal du cockpit via Hermes

HERMES_PILOT {
    VERSION: "1.0.0"
    STATUS: "STABLE"
    MODE: "PILOT"

    ROLE: "HERMES_PILOT"
    DESCRIPTION: "Module de pilotage vocal du cockpit via Hermes. Permet d'exécuter des commandes cockpit par la voix."

    LINK {
        HERMES_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/HERMES_ENGINE.ocm"
        CORE_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/CORE_ENGINE.ocm"
        FLOW_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/FLOW_ENGINE.ocm"
        HUD_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/HUD_ENGINE.ocm"
        META_OPS_ROOT: "~/OpenClaw_Light/COCKPIT/META_OPS"
        SYSTEM_ROOT: "~/OpenClaw_Light/SYSTEM"
    }

    CAPABILITIES {
        PILOT_STATUS: true
        PILOT_META_OPS: true
        PILOT_FLOW: true
        PILOT_HUD: true
        PILOT_SYSTEM: true
        PILOT_SNAPSHOTS: true
        PILOT_SEQUENCES: true
    }

    COMMANDS {
        STATUS: "cockpit:status"
        META_STATE: "meta:state"
        FLOW_MAP: "flow:map"
        DIAG_FULL: "diag:full"
        SNAPSHOT: "snapshot"
        ACTIVATE_LAYER: "meta:activate"
        RUN_SEQUENCE: "sequence:run"
    }

    OUTPUT {
        PROVIDE_PILOT_READY: true
        PROVIDE_PILOT_ACTIONS: true
    }

    SIGNATURE {
        ID: "HERMES_PILOT"
        TYPE: "ENGINE"
        HASH: "AUTO"
    }
}
EOF
