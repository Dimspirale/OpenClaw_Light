# FLOW_ENGINE.ocm
# OpenClaw_Light — Flow Engine
# Circulation interne du cockpit, gestion du flux, dynamique interne

FLOW_ENGINE {
    VERSION: "1.0.0"
    STATUS: "STABLE"
    MODE: "FLOW"

    ROLE: "FLOW_ENGINE"
    DESCRIPTION: "Moteur de circulation interne. Gestion du flux entre HUD, CORE, META_OPS et SYSTEM."

    ENGINE {
        ENABLED: true
        FLOW_IN: true
        FLOW_OUT: true
        FLOW_ROUTE: true
        FLOW_BALANCE: true
    }

    INPUT {
        HUD_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/HUD_ENGINE.ocm"
        CORE_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/CORE_ENGINE.ocm"
        META_OPS_ROOT: "~/OpenClaw_Light/COCKPIT/META_OPS"
        SYSTEM_ROOT: "~/OpenClaw_Light/SYSTEM"
    }

    OUTPUT {
        PROVIDE_FLOW: true
        PROVIDE_BALANCE: true
        PROVIDE_ROUTING: true
    }

    SIGNATURE {
        ID: "FLOW_ENGINE"
        TYPE: "ENGINE"
        HASH: "AUTO"
    }
}
