# HERMES_COMMANDS.ocm
# OpenClaw_Light — Hermes Commands Engine
# Actions cockpit avancées, macros, séquences, automatisations

HERMES_COMMANDS {
    VERSION: "1.0.0"
    STATUS: "STABLE"
    MODE: "COMMANDS"

    ROLE: "HERMES_COMMANDS"
    DESCRIPTION: "Moteur d'actions cockpit avancées : macros, séquences, automatisations, commandes complexes."

    LINK {
        HERMES_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/HERMES_ENGINE.ocm"
        CORE_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/CORE_ENGINE.ocm"
        FLOW_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/FLOW_ENGINE.ocm"
        HUD_ENGINE: "~/OpenClaw_Light/COCKPIT/ENGINE/HUD_ENGINE.ocm"
        META_OPS_ROOT: "~/OpenClaw_Light/COCKPIT/META_OPS"
        SYSTEM_ROOT: "~/OpenClaw_Light/SYSTEM"
    }

    CAPABILITIES {
        ACTION_SIMPLE: true
        ACTION_COMPLEX: true
        MACROS: true
        SEQUENCES: true
        AUTOMATION: true
        MULTI_ACTION: true
        META_OPS_CONTROL: true
        FLOW_CONTROL: true
        SYSTEM_CONTROL: true
    }

    COMMANDS {
        RUN: "action:run"
        MACRO: "macro:run"
        SEQUENCE: "sequence:run"
        META_ACTIVATE: "meta:activate"
        META_CHAIN: "meta:chain"
        FLOW_EXEC: "flow:exec"
        SYSTEM_CALL: "system:call"
        MULTI: "multi:run"
    }

    OUTPUT {
        PROVIDE_COMMANDS_READY: true
        PROVIDE_ACTION_STATUS: true
        PROVIDE_AUTOMATION_STATUS: true
    }

    SIGNATURE {
        ID: "HERMES_COMMANDS"
        TYPE: "ENGINE"
        HASH: "AUTO"
    }
}
