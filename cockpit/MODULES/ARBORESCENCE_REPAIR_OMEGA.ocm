#!/bin/bash
# ARBORESCENCE_REPAIR_OMEGA.ocm — Hermès Cockpit Arborescence Repair OMEGA v10.0
# Auto-réparation + auto-réécriture + optimisation cosmique

ROOT="$HOME/OpenClaw_Light"
LOG="$ROOT/cockpit/reports/ARBORESCENCE_REPAIR_OMEGA.log"

echo "=== HERMÈS ARBORESCENCE REPAIR OMEGA — ACTIVATION COSMIQUE ==="
echo "Log : $LOG"
echo "Racine : $ROOT"
echo

echo "=== OMEGA LOG — $(date) ===" > "$LOG"

###############################################
# 1. AUTO-RÉPARATION DES MODULES DE RÉPARATION
###############################################

REPAIR_MODULES=(
  "ARBORESCENCE_REPAIR_ZERO.ocm"
  "ARBORESCENCE_REPAIR_Ω.ocm"
  "ARBORESCENCE_REPAIR_ABSOLUTE.ocm"
  "ARBORESCENCE_REPAIR_INFINITY.ocm"
  "ARBORESCENCE_REPAIR_OMNI.ocm"
  "ARBORESCENCE_REPAIR_SINGULARITY.ocm"
  "ARBORESCENCE_REPAIR_ULTRA.ocm"
  "ARBORESCENCE_REPAIR_ULTIMATE.ocm"
)

for m in "${REPAIR_MODULES[@]}"; do
  if [ ! -f "$ROOT/cockpit/MODULES/$m" ]; then
    echo "[REGENERATE] $m" >> "$LOG"
    echo "#!/bin/bash" > "$ROOT/cockpit/MODULES/$m"
    echo "# Placeholder auto-regenerated by OMEGA" >> "$ROOT/cockpit/MODULES/$m"
    chmod +x "$ROOT/cockpit/MODULES/$m"
  else
    echo "[OK] $m" >> "$LOG"
  fi
done

###############################################
# 2. AUTO-RÉÉCRITURE DE LA LOGIQUE INTERNE
###############################################

echo "[OMEGA] Vérification et correction des permissions..."
find "$ROOT" -type f \( -name "*.sh" -o -name "*.ocm" \) -exec chmod +x {} \; -exec echo "[CHMOD] {}" >> "$LOG" \;

echo "[OMEGA] Suppression des fichiers parasites..."
find "$ROOT" -type f -name "*:Zone.Identifier" -exec rm -f {} \; -exec echo "[DEL] {}" >> "$LOG" \;
find "$ROOT" -type f \( -name "*Copie*" -o -name "*(*).*" \) -exec rm -f {} \; -exec echo "[DEL] {}" >> "$LOG" \;

echo "[OMEGA] Conversion CRLF → LF..."
grep -rl $'\r' "$ROOT" | while read -r f; do
  sed -i 's/\r$//' "$f"
  echo "[LF] $f" >> "$LOG"
done

###############################################
# 3. OPTIMISATION COSMIQUE
###############################################

echo "[OMEGA] Reconstruction des dossiers critiques..."
for d in "${CRITICAL_DIRS[@]}"; do
  mkdir -p "$ROOT/$d"
  echo "[REBUILD] $d" >> "$LOG"
done

echo "[OMEGA] Auto-optimisation terminée."
echo "[EVOLVE] $(date)" >> "$LOG"

###############################################
# 4. SURVEILLANCE CONTINUE
###############################################

echo "[OMEGA] Activation du mode INFINITY cosmique..."
inotifywait -m -r "$ROOT" -e create -e delete -e modify |
while read -r path action file; do
  echo "[∞ OMEGA] $action → $file" >> "$LOG"

  if [[ "$file" == *":Zone.Identifier" ]]; then
    rm -f "$path/$file"
    echo "[DEL] $path/$file" >> "$LOG"
  fi

  if [[ "$file" == *"Copie"* || "$file" == *"("*")"* ]]; then
    rm -f "$path/$file"
    echo "[DEL] $path/$file" >> "$LOG"
  fi

  if [[ "$file" == *.sh || "$file" == *.ocm ]]; then
    chmod +x "$path/$file"
    echo "[CHMOD] $path/$file" >> "$LOG"
  fi

  if grep -q $'\r' "$path/$file" 2>/dev/null; then
    sed -i 's/\r$//' "$path/$file"
    echo "[LF] $path/$file" >> "$LOG"
  fi
done
