#!/bin/bash
# ARBORESCENCE_REPAIR_INFINITY+OMEGA.ocm — Hermès Cockpit Hybrid Repair v11.0
# Fusion INFINITY + OMEGA : surveillance continue + régénération cosmique

ROOT="$HOME/OpenClaw_Light"
LOG="$ROOT/cockpit/reports/ARBORESCENCE_REPAIR_INFINITY+OMEGA.log"

echo "=== HERMÈS ARBORESCENCE REPAIR INFINITY+OMEGA — ACTIVATION ==="
echo "Log : $LOG"
echo "Racine : $ROOT"
echo

echo "=== INFINITY+OMEGA LOG — $(date) ===" > "$LOG"

###############################################
# 1. AUTO-RÉPARATION DES MODULES DE RÉPARATION
###############################################

REPAIR_MODULES=(
  "ARBORESCENCE_REPAIR_ZERO.ocm"
  "ARBORESCENCE_REPAIR_Ω.ocm"
  "ARBORESCENCE_REPAIR_ABSOLUTE.ocm"
  "ARBORESCENCE_REPAIR_INFINITY.ocm"
  "ARBORESCENCE_REPAIR_OMNI.ocm"
  "ARBORESCENCE_REPAIR_SINGULARITY.ocm"
  "ARBORESCENCE_REPAIR_ULTRA.ocm"
  "ARBORESCENCE_REPAIR_ULTIMATE.ocm"
  "ARBORESCENCE_REPAIR_OMEGA.ocm"
)

for m in "${REPAIR_MODULES[@]}"; do
  if [ ! -f "$ROOT/cockpit/MODULES/$m" ]; then
    echo "[REGENERATE] $m" >> "$LOG"
    echo "#!/bin/bash" > "$ROOT/cockpit/MODULES/$m"
    echo "# Placeholder auto-regenerated by INFINITY+OMEGA" >> "$ROOT/cockpit/MODULES/$m"
    chmod +x "$ROOT/cockpit/MODULES/$m"
  else
    echo "[OK] $m" >> "$LOG"
  fi
done

###############################################
# 2. SURVEILLANCE CONTINUE + AUTO-RÉPARATION
###############################################

echo "[∞Ω] Activation du flux hybride..."
inotifywait -m -r "$ROOT" -e create -e delete -e modify |
while read -r path action file; do
  echo "[∞Ω] $action → $file" >> "$LOG"

  # Suppression automatique des fichiers parasites
  if [[ "$file" == *":Zone.Identifier" ]]; then
    rm -f "$path/$file"
    echo "[DEL] $path/$file" >> "$LOG"
  fi

  if [[ "$file" == *"Copie"* || "$file" == *"("*")"* ]]; then
    rm -f "$path/$file"
    echo "[DEL] $path/$file" >> "$LOG"
  fi

  # Correction automatique des permissions
  if [[ "$file" == *.sh || "$file" == *.ocm ]]; then
    chmod +x "$path/$file"
    echo "[CHMOD] $path/$file" >> "$LOG"
  fi

  # Conversion CRLF → LF
  if grep -q $'\r' "$path/$file" 2>/dev/null; then
    sed -i 's/\r$//' "$path/$file"
    echo "[LF] $path/$file" >> "$LOG"
  fi

  # Régénération cosmique si un module est corrompu
  if [[ "$file" == *"ARBORESCENCE_REPAIR"* && ! -s "$path/$file" ]]; then
    echo "#!/bin/bash" > "$path/$file"
    echo "# Auto-regenerated by INFINITY+OMEGA" >> "$path/$file"
    chmod +x "$path/$file"
    echo "[REGENERATE] $path/$file" >> "$LOG"
  fi
done
