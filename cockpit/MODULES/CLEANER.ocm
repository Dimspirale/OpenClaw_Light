#!/bin/bash
# CLEANER.ocm — Hermès Cockpit Cleaner v1.0
# Zéro artefact, zéro CRLF, diagnostic complet

echo "=== HERMÈS CLEANER — DIAGNOSTIC INITIAL ==="

echo "[1] Recherche des fichiers Zone.Identifier..."
ZI_FILES=$(find . -type f -name "*:Zone.Identifier")
echo "$ZI_FILES"

echo "[2] Recherche des copies Windows (Copie, (1), (2)..."
COPY_FILES=$(find . -type f \( -name "*Copie*.sh" -o -name "*(*).sh" \))
echo "$COPY_FILES"

echo "[3] Réparation des permissions..."
find . -type f -name "*.sh" -exec chmod +x {} \;

echo "[4] Suppression des fichiers pollués..."
find . -type f -name "*:Zone.Identifier" -exec rm -f {} \;
find . -type f \( -name "*Copie*.sh" -o -name "*(*).sh" \) -exec rm -f {} \;

echo "[5] Vérification finale..."
find . -maxdepth 3 -type f

echo "=== CLEANER.ocm — OPÉRATION TERMINÉE ==="
